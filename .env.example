
# ============================================================
# Multimodal AI Chatbot - Gemini Only
# ============================================================

# ---- AI Provider: Google Gemini only ----
GEMINI_API_KEY=
AI_PROVIDER=gemini

# Models
GEMINI_CHAT_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ---- Security ----
SECRET_KEY=
CHAT_FALLBACK_MODEL=gemini-3.5-flash-lite
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
TRUST_PROXY=false

# ---- Database ----
POSTGRES_USER=chatbot
POSTGRES_PASSWORD=
POSTGRES_DB=chatbot

# ---- Uploads & privacy ----
MAX_IMAGE_MB=10
MAX_DOC_MB=25
MAX_AUDIO_MB=25
MAX_PDF_PAGES=400
USER_STORAGE_MB=500
FILE_RETENTION_DAYS=30
TESSERACT_LANGS=eng+hin+mar

# ---- Rate limits ----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_AI_PER_MINUTE=30
RATE_LIMIT_DEFAULT_PER_MINUTE=240

LOG_LEVEL=INFO
ENABLE_TOOLS=true
